{
  "name": "gentle-space-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "sync:listings": "tsx scripts/run-listings-sync.ts",
    "sync:preview": "tsx --env-file=.env.local scripts/preview-listings-sync.ts",
    "sync:check": "tsx --env-file=.env.local scripts/check-incremental-sync.ts",
    "embed:backfill": "tsx --env-file=.env.local scripts/backfill-embeddings.ts",
    "entities:submit": "tsx --env-file=.env.local scripts/submit-entity-extraction.ts",
    "graph:rebuild": "tsx --env-file=.env.local scripts/rebuild-listing-graph.ts",
    "graph:check": "tsx --env-file=.env.local scripts/check-graph-boost.ts",
    "insight:check": "tsx --env-file=.env.local scripts/check-insight.ts"
