# Consolidated Postgres (PG18 + AGE + pgvector) — from repo root:
#   docker compose -f docker-compose.listings.yml up -d
DATABASE_URL=postgresql://gentle:gentle@localhost:5433/gentle_space_listings
TEST_DATABASE_URL=postgresql://gentle:gentle@localhost:5433/gentle_space_listings
# Production must use adsagent_rw (see scripts/consolidate/03-set-role-passwords.sh).
# Local dev on the bootstrap superuser needs this until role passwords are wired:
SKIP_DB_ROLE_CHECK=1

# Meta Marketing API (see README.md for how to obtain these)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Google Ads API (see README.md for how to obtain these)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Manager (MCC) ID when CUSTOMER_ID is a client under that manager — required by Google Ads API
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# In-repo Google Ads MCP server (npm run mcp:google-ads)
GOOGLE_ADS_MCP_URL=http://localhost:8766/mcp
# Comma-separated Host-header allowlist for the Google Ads MCP server's DNS-rebinding guard.
# Defaults to localhost,127.0.0.1 when unset; docker-compose.yml sets this to include
# "google-ads-mcp" (the Compose service name) so other containers can reach it.
GOOGLE_ADS_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
# Listen address for the Google Ads MCP HTTP server. Defaults to localhost (tsx-on-host).
# docker-compose.yml / deploy set 0.0.0.0 so published ports and Compose DNS can reach it.
GOOGLE_ADS_MCP_BIND=localhost

# Twenty CRM (local dev stack — infra/twenty/docker compose up)
TWENTY_BASE_URL=http://localhost:3020
TWENTY_API_KEY=
# Twenty MCP Streamable HTTP gateway (docker compose up -d twenty-mcp-gateway)
TWENTY_MCP_URL=http://localhost:8765/mcp

# --- Twenty per-org tenancy (S4 Task 10–11) ---
# Shared contaminated instance URL — interim guard blocks non-platform orgs from this base URL.
# Local: http://localhost:3020  |  Production: https://crm.gentlespacesolutions.com
SHARED_TWENTY_BASE_URL=http://localhost:3020
# Internal org id (public.orgs where kind = 'internal'). Seed: 00000000-0000-0000-0000-000000000001
PLATFORM_ORG_ID=
# App-data MCP server tenant (scripts/run-app-data-mcp.ts)
MCP_ORG_ID=

# Per-org provisioning via Coolify (scripts/provision-twenty-instance.ts).
# Local docker only (no Coolify): --local on provision-twenty-instance.ts or provision-twenty-gaps.ts
#   TWENTY_PG_ADMIN_URL=postgresql://gentle:gentle@localhost:5433/postgres
#   TWENTY_PG_PASSWORD=<tenant role password>
#   LOCAL_TWENTY_USE_SHARED_KEY=1   # use env://TWENTY_API_KEY for every org
# All uncovered orgs locally:
#   npx tsx --env-file=.env.local scripts/provision-twenty-gaps.ts --local --activate
# Coolify MCP exposes COOLIFY_ACCESS_TOKEN; the script also accepts COOLIFY_API_TOKEN.
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=
COOLIFY_PROJECT_UUID=
COOLIFY_SERVER_UUID=
COOLIFY_ENVIRONMENT=production
TWENTY_DOMAIN_SUFFIX=crm.gentlespacesolutions.com
# Postgres host reachable from Twenty containers on the Coolify server (e.g. gentle-space-pg)
TWENTY_PG_HOST=
TWENTY_PG_PASSWORD=
# Superuser URL for ensureTenantPostgres (local dev: postgresql://gentle:gentle@localhost:5433/postgres)
TWENTY_PG_ADMIN_URL=
# Or run DDL on the Coolify host when Postgres is not reachable from here:
# TWENTY_PG_ENSURE_SSH=root@100.71.169.23
# TWENTY_PG_ENSURE_CONTAINER=db-fesbgw5idbhcctacp5x60wv8
TWENTY_APP_SECRET=
TWENTY_ENCRYPTION_KEY=
TWENTY_TAG=latest

# Bifrost AI gateway (chat + rationale). Start with: docker compose up -d bifrost
BIFROST_BASE_URL=http://localhost:8080
BIFROST_CHAT_MODEL=vertex/gemini-2.5-flash-lite
VERTEX_PROJECT_ID=propane-galaxy-498403-n8
# base64-encoded service-account JSON (see ads-agent/bifrost/README.md)
VERTEX_AUTH_CREDENTIALS=

# Worker schedule (cron syntax); default: every 6 hours
CRON_SCHEDULE=0 */6 * * *

# In-repo app-data MCP server (npm run mcp:app-data) — read-only CRM + analytics tools for Hermes.
APP_DATA_MCP_URL=http://localhost:8767/mcp
APP_DATA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,host.docker.internal
APP_DATA_MCP_BIND=localhost

# --- S8/S8a: Garage artifact store + context graph (local dev) ---
GARAGE_S3_ENDPOINT=http://127.0.0.1:3900
GARAGE_REGION=garage
GARAGE_ADMIN_ENDPOINT=http://127.0.0.1:3903
GARAGE_ADMIN_TOKEN=dev-admin-token-change-me
ARTIFACT_ACCESS_KEY_ID=<printed by scripts/garage/bootstrap.sh>
ARTIFACT_SECRET_ACCESS_KEY=<printed by scripts/garage/bootstrap.sh>
ARTIFACT_BUCKET=gs-artifacts
ARTIFACT_ORPHAN_GRACE_SECONDS=3600
SNAPSHOT_STAGING_BUCKET=gs-graph-staging
SNAPSHOT_MASTER_KEY=<64 hex chars; openssl rand -hex 32>
SNAPSHOT_TTL_SECONDS=604800
SNAPSHOT_LEASE_SECONDS=300
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_USER=etl_writer
CLICKHOUSE_PASSWORD=etl
CLICKHOUSE_DATABASE=gentle_space
GRAPH_REBUILD_CEILING=2
GRAPH_REBUILD_DEBOUNCE_SECONDS=300
GRAPH_REBUILD_LEASE_SECONDS=900
DUCKDB_BIN=./.bin/duckdb

# Hermes agent API server (see docs/superpowers/plans/2026-08-10-hermes-agent-container-install.md).
# HERMES_API_SERVER_ENABLED must be set to true in ~/.hermes/.env on the machine running Hermes.
HERMES_API_SERVER_URL=http://127.0.0.1:8642
HERMES_API_SERVER_KEY=
HERMES_API_SERVER_MODEL=hermes-agent
# Optional: model slug used for usage_ledger pricing (Hermes reports hermes-agent by default).
# HERMES_API_SERVER_BILLING_MODEL=google/gemini-2.5-pro
