{
  "name": "ads-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "pubsub:bootstrap": "tsx --env-file=.env.local scripts/bootstrap-pubsub-emulator.ts",
    "relay": "tsx --env-file=.env.local scripts/run-outbox-relay.ts",
    "reconcile:deletions": "tsx --env-file=.env.local scripts/run-deletion-reconciler.ts",
    "migrate": "tsx --env-file=.env.local lib/db/migrate.ts",
    "migrate:down": "tsx --env-file=.env.local lib/db/migrate.ts --down",
    "worker": "tsx --env-file=.env.local scripts/run-decision-cycle.ts",
    "worker:projection": "tsx --env-file=.env.local scripts/run-twenty-projection.ts",
    "worker:reminders": "tsx --env-file=.env.local scripts/run-reminder-scheduler.ts",
    "cycle:run": "tsx --env-file=.env.local scripts/run-once.ts",
    "mcp:google-ads": "tsx --env-file=.env.local scripts/run-google-ads-mcp.ts",
    "mcp:app-data": "tsx --env-file=.env.local scripts/run-app-data-mcp.ts",
    "seed:performance": "tsx --env-file=.env.local scripts/seed-dev-performance.ts"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.0.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@openuidev/lang-core": "^0.2.10",
    "@openuidev/react-headless": "^0.9.7",
    "@openuidev/react-lang": "^0.2.9",
    "@openuidev/react-ui": "^0.13.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "facebook-nodejs-business-sdk": "^22.0.0",
    "framer-motion": "^12.43.0",
    "google-ads-api": "^21.0.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.28.0",
    "next": "15.5.21",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
