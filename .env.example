# Legacy — unused after MapEmbed removal (spaces maps use NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY)
GOOGLE_MAPS_EMBED_KEY=

# Browse map — Maps JavaScript API (browser; restrict by HTTP referrer).
# Allow every local Next port you use (e.g. http://localhost:3000/* … :3003/*) or
# Maps paints "Oops! Something went wrong" (RefererNotAllowedMapError).
NEXT_PUBLIC_GOOGLE_MAPS_JS_KEY=

DATABASE_URL=
LISTING_DETAIL_TTL_DAYS=7
LISTING_MISSING_RUNS_LIMIT=3
VERTEX_BATCH_BUCKET=
ENTITIES_SUBMIT_LIMIT=

# AI search insight — Places API (New) nearby lookup (server-only; authorize for Places API (New), not for browser use)
GOOGLE_PLACES_API_KEY=

# Canonical site origin (no trailing slash). Powers metadataBase, canonicals,
# sitemap, robots, and structured data. Defaults to the Render URL if unset.
NEXT_PUBLIC_SITE_URL=

# Analytics — each is optional and inert until set (no script loads without an ID).
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=
