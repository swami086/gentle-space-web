{
  "mcpServers": {
    "pencil-docker": {
      "command": "/Users/swami/.cursor/bin/pencil-mcp-docker-launcher.sh",
      "args": [],
      "env": {
        "PENCIL_PROJECT_SLUG": "gentlespace_web"
      }
    },
    "openmemory-gentlespace": {
      "alwaysAllow": [
        "add_memories",
        "search_memory",
        "list_memories",
        "delete_all_memories"
      ],
      "url": "http://136.67.164.6:8765/mcp/cursor/sse/GentleSpace"
    },
    "figma": {
      "url": "https://mcp.figma.com/mcp"
    },
    "figma-desktop": {
      "url": "http://127.0.0.1:3845/mcp"
    },
    "apify": {
      "url": "https://mcp.apify.com"
    },
    "artlist": {
      "url": "https://mcp.artlist.io/mcp"
    },
    "composio": {
      "url": "https://connect.composio.dev/mcp"
    },
    "google-calendar": {
      "url": "https://calendarmcp.googleapis.com/mcp/v1",
      "headers": {},
      "auth": {
        "CLIENT_ID": "332467315549-dgefaqi2h3i5pbhpmhkluh5lvmpmt6aj.apps.googleusercontent.com",
        "CLIENT_SECRET": "${env:GOOGLE_CALENDAR_CLIENT_SECRET}",
        "scopes": [
          "https://www.googleapis.com/auth/calendar.calendarlist.readonly",
          "https://www.googleapis.com/auth/calendar.events.freebusy",
          "https://www.googleapis.com/auth/calendar.events.readonly",
          "https://www.googleapis.com/auth/calendar.events"
        ]
      }
    },
    "lusha": {
      "url": "https://mcp.lusha.com",
      "headers": {
        "x-api-key": "${env:LUSHA_API_KEY}"
      }
    },
    "linear": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        "https://mcp.linear.app/mcp"
      ]
    },
    "Mobbin": {
      "type": "http",
      "url": "https://api.mobbin.com/mcp",
      "headers": {}
    },
    "netlify": {
      "command": "npx",
      "args": [
        "-y",
        "@netlify/mcp"
      ],
      "env": {
        "NETLIFY_PERSONAL_ACCESS_TOKEN": "${env:NETLIFY_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "notion": {
      "url": "https://mcp.notion.com/mcp"
    },
    "openbnb": {
      "type": "http",
      "url": "https://mcp.openbnb.ai/mcp"
    },
    "pm-skills": {
      "command": "npx",
      "args": [
        "-y",
        "ai-pm-skills-mcp"
      ],
      "env": {}
    },
    "semrush": {
      "url": "https://mcp.semrush.com/v1/mcp"
    },
    "sequential-thinking": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "env": {}
    },
    "stackgen-admin": {
      "type": "sse",
      "url": "https://cloud.stackgen.com/api/mcp/admin",
      "headers": {
        "Authorization": "Bearer ${env:STACKGEN_TOKEN}"
      }
    },
    "stackgen-user": {
      "type": "sse",
      "url": "https://cloud.stackgen.com/api/mcp/user",
      "headers": {
        "Authorization": "Bearer ${env:STACKGEN_TOKEN}"
      }
    },
    "stackgen-stage": {
      "type": "sse",
      "url": "https://demo.cloud.stackgen.com/api/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${env:STACKGEN_STAGE_TOKEN}"
      }
    },
    "render": {
      "url": "https://mcp.render.com/mcp",
      "auth": {
        "CLIENT_ID": "cursor"
      }
    },
    "21st": {
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${env:TWENTYFIRST_API_KEY}"
      }
    },
    "tinyfish": {
      "url": "https://agent.tinyfish.ai/mcp"
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${env:FIRECRAWL_API_KEY}"
      }
    }
  }
}
